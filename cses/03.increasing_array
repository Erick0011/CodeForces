#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main() {


    int n;
    cin >> n;
    int s[n];
    long long x = 0;

    for (int i = 0; i < n; i++ ) {
        cin >> s[i];
    }


    for(int i = 1; i < n; i++) {
        if (s[i] < s[i - 1]) {
            x +=  s[i - 1] - s[i];
            s[i] = s[i - 1];

        }
    }
    cout << x;

    return 0;

}
